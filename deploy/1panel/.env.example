# Images published by .github/workflows/docker-image.yml
GHCR_OWNER=sydneypoole
IMAGE_TAG=latest
TELEGRAM_BOT_API_TAG=10.2

# Host ports managed by 1Panel
WEB_PORT=8080
TG_API_LOCAL_PORT=8081

# Public K-Vault URL configured in the 1Panel website reverse proxy
PUBLIC_BASE_URL=https://vault.example.com

# Administrator login
BASIC_USER=admin
BASIC_PASS=replace_with_a_strong_password

# Generate each value separately with: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=replace_with_64_hex_characters
SESSION_SECRET=replace_with_another_64_hex_characters
FILE_URL_SECRET=replace_with_another_64_hex_characters
TG_WEBHOOK_SECRET=replace_with_another_64_hex_characters

# Telegram bot and target channel/group
TG_BOT_TOKEN=TOKEN
TG_CHAT_ID=-1001234567890

# Obtain these at https://my.telegram.org -> API development tools
TELEGRAM_API_ID=API_ID
TELEGRAM_API_HASH=API_HASH
TELEGRAM_VERBOSITY=2

# Application policy
TELEGRAM_LINK_MODE=signed
TELEGRAM_METADATA_MODE=on
TG_UPLOAD_NOTIFY=true
GUEST_UPLOAD=false
GUEST_MAX_FILE_SIZE=5242880
GUEST_DAILY_LIMIT=10
UPLOAD_MAX_SIZE=104857600
UPLOAD_SMALL_FILE_THRESHOLD=20971520
CHUNK_SIZE=5242880
